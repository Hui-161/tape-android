<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Theme.Tape: dark baseline, no action bar (Compose draws its own).
      Real colors come from the Compose Theme.kt; this XML theme only
      provides the system bars + splash background.
    -->
    <style name="Theme.Tape" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/ink_background</item>
        <item name="android:navigationBarColor">@color/ink_background</item>
        <item name="android:windowBackground">@color/ink_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>