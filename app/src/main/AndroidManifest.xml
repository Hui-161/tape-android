<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for ARCore (camera access). Requested at runtime on the permission screen. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- SceneView declares INTERNET to load 3D models from URLs. Tape renders no models and
         keeps everything on the device, so the merged manifest must not carry it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- ARCore is required hardware for v1's AR measurement. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Apps that use ARCore must declare the meta-data tag. -->
    <application
        android:name=".TapeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tape">

        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!-- configChanges: rotating must not recreate the activity, which would restart the
             AR session and lose a measurement in progress. Compose relayouts, and SceneView
             updates the ARCore display geometry when its view is resized. -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.Tape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
