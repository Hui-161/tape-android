    "statusBar.debuggingForeground": "#0F0E0C",
    "statusBar.noFolderBackground": "#0A0907",
    "statusBarItem.activeBackground": "#E89B3C25",
    "statusBarItem.hoverBackground": "#E89B3C15",
    "statusBarItem.prominentBackground": "#3A352E",
    "statusBarItem.prominentForeground": "#FFC857",
    "statusBarItem.prominentHoverBackground": "#E89B3C35",
    "statusBarItem.errorBackground": "#D16A6A",
    "statusBarItem.errorForeground": "#0F0E0C",
    "statusBarItem.warningBackground": "#E89B3C",
    "statusBarItem.warningForeground": "#0F0E0C",

    "breadcrumb.foreground": "#B6A88F",
    "breadcrumb.focusForeground": "#FFC857",
    "breadcrumb.activeSelectionForeground": "#FFC857",
    "breadcrumbPicker.background": "#1F1C18",

    "editorGutter.modifiedBackground": "#E89B3C",
    "editorGutter.addedBackground": "#7BB87B",
    "editorGutter.deletedBackground": "#D16A6A",
    "editorGutter.commentRangeForeground": "#6E6557",
    "editor.codeLensForeground": "#6E6557",

    "diffEditor.insertedTextBackground": "#7BB87B30",
    "diffEditor.removedTextBackground": "#D16A6A30",
    "diffEditor.diagonalFill": "#3A352E",
    "diffEditor.insertedLineBackground": "#7BB87B15",
    "diffEditor.removedLineBackground": "#D16A6A15",

    "badge.background": "#E89B3C",
    "badge.foreground": "#0F0E0C",

    "gitDecoration.modifiedResourceForeground": "#E89B3C",
    "gitDecoration.deletedResourceForeground": "#D16A6A",
    "gitDecoration.untrackedResourceForeground": "#7BB87B",
    "gitDecoration.ignoredResourceForeground": "#6E6557",
    "gitDecoration.conflictingResourceForeground": "#D16A6A"
  },
  "tokenColors": [
    {
      "_comment": "Kotlin keywords, control flow, modifiers",
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.as",
        "keyword.control.conditional",
        "keyword.control.repeat",
        "keyword.control.return",
        "keyword.operator",
        "storage.modifier",
        "storage.type",
        "storage.type.kotlin"
      ],
      "settings": { "foreground": "#E89B3C", "fontStyle": "bold" }
    },
    {
      "_comment": "Strings, characters, regex",
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.template",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": { "foreground": "#FFC857" }
    },
    {
      "_comment": "Numbers, booleans, null, this/super (literal-ish values)",
      "name": "Constants & literals",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.other",
        "variable.language"
      ],
      "settings": { "foreground": "#FFC857" }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.documentation",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#6E6557", "fontStyle": "italic" }
    },
    {
      "_comment": "Function/method names and invocations",
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.kotlin",
        "support.function",
        "support.function.builtin",
        "meta.function-call"
      ],
      "settings": { "foreground": "#F4ECDF", "fontStyle": "bold" }
    },
    {
      "_comment": "Function parameters and local val/var declarations — this is what you asked to distinguish",
      "name": "Variables & parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "variable.parameter.kotlin",
        "meta.parameter",
        "meta.definition.variable"
      ],
      "settings": { "foreground": "#E89B3C" }
    },
    {
      "_comment": "Constants from companion object, top-level const val, UPPER_SNAKE_CASE",
      "name": "Constants (UPPER_SNAKE_CASE)",
      "scope": [
        "variable.other.constant",
        "variable.other.constant.kotlin"
      ],
      "settings": { "foreground": "#FFC857", "fontStyle": "bold" }
    },
    {
      "_comment": "Type / class / interface / object declarations and references",
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.object",
        "entity.name.type.typealias",
        "entity.name.type.kotlin",
        "support.class",
        "support.type",
        "support.type.kotlin"
      ],
      "settings": { "foreground": "#FFC857", "fontStyle": "bold" }
    },
    {
      "_comment": "Property references (e.g. Color.kt val AmberTop)",
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.property.kotlin",
        "support.other.property"
      ],
      "settings": { "foreground": "#B6A88F" }
    },
    {
      "_comment": "Composable annotations, @Preview, @Composable",
      "name": "Annotations & decorators",
      "scope": [
        "meta.annotation",
        "meta.decorator",
        "punctuation.definition.annotation",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "#D16A6A", "fontStyle": "italic" }
    },
    {
      "_comment": "Imports & package declarations",
      "name": "Imports / package",
      "scope": [
        "meta.import",
        "entity.name.package",
        "keyword.control.import"
      ],
      "settings": { "foreground": "#B6A88F" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.string",
        "punctuation.definition.block",
        "punctuation.section",
        "meta.brace",
        "meta.bracket",
        "meta.paren"
      ],
      "settings": { "foreground": "#B6A88F" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": { "foreground": "#E89B3C" }
    },
    {
      "_comment": "TODO/FIXME markers inside comments",
      "name": "TODO markers",
      "scope": [
        "comment.line.warning",
        "comment.line.documentation",
        "comment.block.documentation",
        "markup.deleted",
        "markup.inserted"
      ],
      "settings": { "foreground": "#E89B3C", "fontStyle": "italic bold" }
    },
    {
      "name": "Markdown headings (in-code preview blocks)",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": { "foreground": "#FFC857", "fontStyle": "bold" }
    }
  ]
}
