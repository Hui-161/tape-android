{
  "_comment": "Tape warm-amber TextMate theme. Token colors mirror the runtime palette in app/src/main/java/com/tape/measure/ui/theme/Color.kt so the editor and the app feel like the same product. JSON doesn't support comments; VS Code ignores _comment keys.",
  "name": "Tape Warm Amber",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColorCustomizations": {
    "enabled": true
  },
  "colors": {
