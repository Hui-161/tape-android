    "editorIndentGuide.background": "#1F1C18",
    "editorIndentGuide.activeBackground": "#3A352E",
    "editorWhitespace.foreground": "#3A352E",
    "editorBracketMatch.background": "#E89B3C30",
    "editorBracketMatch.border": "#E89B3C",

    "terminal.background": "#0F0E0C",
    "terminal.foreground": "#F4ECDF",
    "terminalCursor.foreground": "#FFC857",
    "terminal.selectionBackground": "#E89B3C40",
    "terminal.border": "#6E6557",
    "terminal.tab.activeBorder": "#E89B3C",

    "panel.background": "#0F0E0C",
    "panel.border": "#6E6557",
    "panelTitle.activeBorder": "#E89B3C",
    "panelTitle.activeForeground": "#E89B3C",
    "panelTitle.inactiveForeground": "#6E6557",

    "sideBar.background": "#0A0907",
    "sideBar.border": "#6E6557",
