    "menu.background": "#1F1C18",
    "menu.border": "#3A352E",
    "menu.foreground": "#F4ECDF",
    "menu.selectionBackground": "#E89B3C25",
    "menu.selectionForeground": "#FFC857",
    "quickInput.background": "#1F1C18",
    "quickInput.foreground": "#F4ECDF",
    "quickInput.titleBackground": "#0F0E0C",
    "pickerGroup.border": "#E89B3C",
    "pickerGroup.foreground": "#E89B3C",
    "pickerGroup.background": "#1F1C18",

    "notebook.cellBorder": "#3A352E",
    "notebook.activeCellBorder": "#E89B3C",
    "notebook.inactiveSelectedCellBorder": "#3A352E",

    "scrollbarSlider.background": "#E89B3C30",
    "scrollbarSlider.hoverBackground": "#E89B3C50",
    "scrollbarSlider.activeBackground": "#E89B3C70",

    "list.activeSelectionBackground": "#E89B3C25",
