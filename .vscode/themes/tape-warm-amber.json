    "activityBar.foreground": "#B6A88F",
    "activityBar.inactiveForeground": "#6E6557",
    "activityBarBadge.background": "#E89B3C",
    "activityBarBadge.foreground": "#0F0E0C",

    "auxiliaryBar.background": "#0A0907",
    "auxiliaryBar.border": "#6E6557",

    "titleBar.activeBackground": "#0A0907",
