    "tab.activeBorderTop": "#E89B3C",
    "tab.activeForeground": "#F4ECDF",
    "tab.inactiveForeground": "#B6A88F",
    "tab.hoverBorder": "#3A352E",
    "tab.hoverForeground": "#F4ECDF",
    "tab.unfocusedActiveBorder": "#3A352E",
    "tab.unfocusedInactiveBorder": "#3A352E",

    "editorGroup.border": "#6E6557",
    "editorGroupHeader.tabsBackground": "#0A0907",
    "editorGroupHeader.tabsBorder": "#3A352E",
    "editorGroupHeader.noTabsBackground": "#0F0E0C",
    "editorGroup.emptyBackground": "#0F0E0C",

    "focusBorder": "#E89B3C",
    "widget.border": "#3A352E",
    "widget.shadow": "#00000080",
    "input.background": "#1F1C18",
    "input.border": "#E89B3C",
    "input.foreground": "#F4ECDF",
    "input.placeholderForeground": "#6E6557",
    "dropdown.background": "#1F1C18",
    "dropdown.border": "#3A352E",
